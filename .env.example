# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_...). If your project still uses
# the legacy key, you may instead set NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public origin of the app. Used to build OAuth/email redirect URLs.
# Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# --- Server / test only. NEVER expose these to the browser. ---
# Service-role key, used ONLY by Playwright fixtures to create confirmed test
# users. Leave blank in production runtime; set it in CI test env.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (optional) ---
# Ascesis works fully without these. Adding one key switches on the AI helpers:
# drafting arc rules, breaking goals down, expanding task notes, weekly review.
# The key is read on the server only and never reaches the browser.
#
# Use ONE of these:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Optional overrides:
# AI_PROVIDER=anthropic      # force a provider when both keys exist
# AI_MODEL=claude-sonnet-5   # defaults per provider
